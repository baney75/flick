{
  "name": "Flick",
  "short_name": "Flick",
  "description": "Plays your videos, music and books instantly. Builds a fast library from your folders, servers and NAS, and takes any source as a plugin.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0e0d11",
  "theme_color": "#0e0d11",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "video/*": [".mp4", ".m4v", ".mov", ".webm", ".mkv", ".ogv"],
        "audio/*": [".mp3", ".m4a", ".aac", ".flac", ".wav", ".ogg", ".opus"]
      }
    }
  ]
}
